# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_legal
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# FastAPI
ENVIRONMENT=development
DEBUG=true
API_TITLE=Legal ERP System
API_VERSION=1.0.0
API_DESCRIPTION=Enterprise Resource Planning system for legal firms

# JWT & Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@legainerp.com
SMTP_TLS=true

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=erp-legal-documents
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com

# WhatsApp API
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_ID=your-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Logging & Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_TIMEOUT=30000

# IA/ML (Phase 2)
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# File upload limits
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=pdf,doc,docx,xlsx,txt,jpg,png

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Timezone
TIMEZONE=America/Lima
