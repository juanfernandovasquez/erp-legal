# Copia este archivo como .env.staging en el servidor y rellena los valores
# NO commitear .env.staging al repositorio

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=erp_legal

DATABASE_URL=postgresql+asyncpg://postgres:CAMBIAR_POR_PASSWORD_SEGURO@postgres:5432/erp_legal
DATABASE_URL_SYNC=postgresql://postgres:CAMBIAR_POR_PASSWORD_SEGURO@postgres:5432/erp_legal

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_DE_64_CHARS

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO

APP_NAME=ERP Legal
APP_VERSION=1.0.0

# Con Nginx como proxy, las peticiones al backend vienen de la red interna Docker
# No se necesitan orígenes externos en CORS
CORS_ORIGINS=["http://localhost"]
