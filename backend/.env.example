# Application Configuration
APP_NAME=Legal ERP Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/legal_erp
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=False

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# OAuth2 Configuration (Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# AWS Configuration
AWS_S3_BUCKET_NAME=erp-legal-documents
AWS_S3_REGION=us-east-1
AWS_KMS_KEY_ID=your-kms-key-id
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","PATCH","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Security Configuration
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL_CHARS=True
PASSWORD_REQUIRE_NUMBERS=True
PASSWORD_REQUIRE_UPPERCASE=True

# Encryption Configuration
ENCRYPTION_ALGORITHM=AES-256-GCM

# Audit Configuration
ENABLE_AUDIT_LOGGING=True
AUDIT_RETENTION_DAYS=730

# Logging
LOG_LEVEL=INFO

# Sentry Configuration (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@legainerp.com
SMTP_TLS=True

# API Configuration
API_TITLE=Legal ERP System
API_VERSION=1.0.0
API_DESCRIPTION=Enterprise Resource Planning system for legal firms

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_TIMEOUT=30000

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# File Upload Limits
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=["pdf","doc","docx","xlsx","txt","jpg","png"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Timezone
TIMEZONE=America/Lima

# Encryption Keys (base64 encoded)
ENCRYPTION_KEY_default=your-base64-encoded-32-byte-key-here
